{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.1.0/schema.json",
  "name": "clock",
  "position": {
    "x": 20,
    "y": 110,
    "width": 790,
    "height": 575,
    "z": 0,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Hourly"
                    }
                  },
                  "Property": "Hour"
                }
              },
              "queryRef": "Hourly.Hour",
              "nativeQueryRef": "Hour"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Prices"
                    }
                  },
                  "Property": "Mean clock hour EUR per MWh"
                }
              },
              "queryRef": "Prices.Mean clock hour EUR per MWh",
              "nativeQueryRef": "Mean clock hour EUR per MWh"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}
