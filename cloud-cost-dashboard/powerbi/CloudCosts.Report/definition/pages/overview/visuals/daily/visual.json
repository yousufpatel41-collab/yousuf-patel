{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.1.0/schema.json",
  "name": "daily",
  "position": {
    "x": 20,
    "y": 235,
    "width": 730,
    "height": 240,
    "z": 0,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Calendar"
                    }
                  },
                  "Property": "Date"
                }
              },
              "queryRef": "Calendar.Date",
              "nativeQueryRef": "Date"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Costs"
                    }
                  },
                  "Property": "Net billed cost"
                }
              },
              "queryRef": "Costs.Net billed cost",
              "nativeQueryRef": "Net billed cost"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Costs"
                    }
                  },
                  "Property": "Period scenario budget"
                }
              },
              "queryRef": "Costs.Period scenario budget",
              "nativeQueryRef": "Period scenario budget"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}
